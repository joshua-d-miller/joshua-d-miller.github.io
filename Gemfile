source "https://rubygems.org"

# Built by GitHub Actions (.github/workflows/pages.yml), not the classic Pages build,
# so this is plain current Jekyll rather than the github-pages gem (pinned to 3.10).
gem "jekyll", "~> 4.4"

group :jekyll_plugins do
  gem "jekyll-paginate"
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
end

# Windows has no zoneinfo files of its own; needed for `timezone:` in _config.yml
gem "tzinfo-data", platforms: [:windows, :jruby]
