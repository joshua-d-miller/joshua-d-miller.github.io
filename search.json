---
layout: null
sitemap: false
---
[
{%- for post in site.posts -%}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: '%B %-d, %Y' | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "text": {{ post.content | replace: '</', ' </' | replace: '<br', ' <br' | strip_html | normalize_whitespace | jsonify }}
  },
{%- endfor -%}
{%- for p in site.data.projects -%}{%- if p.page -%}
  {
    "title": {{ p.name | append: " (project)" | jsonify }},
    "url": {{ p.page | relative_url | jsonify }},
    "date": "",
    "tags": {{ p.tags | jsonify }},
    "text": {{ p.summary | jsonify }}
  },
{%- endif -%}{%- endfor -%}
  null
]
